name: "UI/UX Code Audit"

on:
  pull_request:
    types: [opened, synchronize]
    paths:
      - '**.html'
      - '**.css'
      - '**.scss'
      - '**.jsx'
      - '**.tsx'
      - '**.vue'

permissions:
  contents: read
  pull-requests: write

jobs:
  ui-ux-ai-audit:
    name: "Audit UI/UX against Design Rules"
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Get Changed UI Files
        id: get-changed-files
        run: |
          # Fetch changed frontend design files between PR target and head
          FILES=$(git diff --name-only --diff-filter=ACMRT ${{ github.event.pull_request.base.sha }} ${{ github.event.pull_request.head.sha }} | grep -E '\.(html|css|scss|jsx|tsx|vue)$' | tr '\n' ' ' || true)
          echo "files=$FILES" >> $GITHUB_OUTPUT

      - name: Set up Node.js
        if: ${{ steps.get-changed-files.outputs.files != '' }}
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Run AI UI/UX Audit
        if: ${{ steps.get-changed-files.outputs.files != '' }}
        id: run-audit
        env:
          OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
          CHANGED_FILES: ${{ steps.get-changed-files.outputs.files }}
        run: |
          cat << 'EOF' > run_audit.js
          const fs = require('fs');
          const https = require('https');

          const files = process.env.CHANGED_FILES.split(' ').filter(Boolean);
          if (files.length === 0) {
            console.log("No relevant files to scan.");
            process.exit(0);
          }

          // Gather content of changed files
          let codePayload = '';
          files.forEach(file => {
            if (fs.existsSync(file)) {
              codePayload += `\n--- FILE: ${file} ---\n` + fs.readFileSync(file, 'utf8') + '\n';
            }
          });

          const prompt = `
          You are an expert UI/UX and Front-End Engineering Design System Auditor. 
          Review the following code changes against these EXACT 25 criteria:

          --- 1. VISUAL SYSTEMS & AESTHETIC PRECISION (FORM) ---
          1. Design System & Token Adherence: Check for hardcoded hex codes or pixel margins instead of dynamic tokens.
          2. Fluid Typography Scale: Verify fluid font scaling (clamp/modular scales) vs fixed px font sizes.
          3. Layout Mechanics & Grid Integrity: Check CSS Grid/Flexbox for alignment and absence of absolute positioning hacks.
          4. Color Contrast & Theme Readiness: Check WCAG contrast and theme hook support (prefers-color-scheme).
          5. Micro-Visual Polish: Inspect border-radius, shadows, scrollbars, and aspect-ratio to prevent layout shifts.

          --- 2. INTERACTIVE UX & UI STATE COVERAGE (FUNCTION & FORM) ---
          6. Interactive State Matrix: Ensure :hover, :focus-visible, :active, and :disabled exist on actionable elements.
          7. Touch Target Standard: Guarantee min 44x44px touch targets on viewports.
          8. Line-Length & Readability: Check body wrappers for 45-75 character (60ch-70ch) max-width limits.
          9. Motion & Reduced Motion Support: Verify transitions use transform/opacity and respect prefers-reduced-motion.
          10. Form UX & Inline Feedback: Validate semantic HTML5 types, <label> bindings, inline errors, and autocomplete tags.

          --- 3. SEMANTIC STRUCTURE & ACCESSIBILITY (FUNCTION) ---
          11. Semantic HTML Architecture: Verify landmark tags (<header>, <nav>, <main>, <aside>, <footer>) over div soup.
          12. Heading Hierarchy Integrity: Ensure sequential <h1>-<h6> flow with zero skipped levels.
          13. Asset Alt Text Strategy: Check alt text strategy on images/icons (meaningful vs alt="" vs aria-hidden="true").
          14. Keyboard Navigation & Tab Order: Ensure natural DOM order, modal focus traps, and proper tabindex.
          15. ARIA Minimization & Validity: Prioritize native HTML over ARIA; check ARIA syntax correctness.

          --- 4. PERFORMANCE & RENDERING MECHANICS (FUNCTION) ---
          16. Asset Loading Optimization: Ensure loading="lazy", decoding="async", and responsive image setups.
          17. Critical CSS & Render Blocking: Detect render-blocking imports or unoptimized CSS.
          18. Font Loading Strategy: Check @font-face rules for font-display: swap or optional.
          19. DOM Depth & Node Count: Identify excessively nested wrappers inflating node count.
          20. Icon & Graphic Delivery: Check SVG efficiency (embedded cleanly, sprites, or optimized markup).

          --- 21. RESILIENCY & EDGE-CASE HANDLING (FORM & FUNCTION) ---
          21. Container Overflow & Edge Defense: Check for text overflow rules (text-overflow, hyphens, overflow-wrap).
          22. Viewport & Safe-Area Bounds: Check dynamic viewports (dvh/svh) and env(safe-area-inset-bottom).
          23. SEO & Social Graph Metadata: Confirm viewport, description, canonical, and Open Graph tags if head elements exist.
          24. Empty & Error States: Verify markup accounts for empty lists, missing images, or fallbacks.
          25. Dead Code & Scope Hygiene: Spot unused CSS classes, redundant vendor prefixes, or inline styles.

          --- INSTRUCTIONS FOR RESPONSE ---
          - Format response in GitHub-flavored Markdown.
          - Group findings by file.
          - Only mention points that have actual issues or notable praises.
          - Provide code snippet solutions for identified issues.

          CODE TO AUDIT:
          ${codePayload}
          `;

          const data = JSON.stringify({
            model: 'gpt-4o',
            messages: [{ role: 'user', content: prompt }],
            temperature: 0.2
          });

          const req = https.request('https://api.openai.com/v1/chat/completions', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${process.env.OPENAI_API_KEY}`
            }
          }, (res) => {
            let body = '';
            res.on('data', chunk => body += chunk);
            res.on('end', () => {
              const response = JSON.parse(body);
              if (response.choices && response.choices[0]) {
                fs.writeFileSync('audit_report.md', "## 🎨 AI UI/UX Design System Audit\n\n" + response.choices[0].message.content);
              } else {
                console.error("API Error:", body);
                process.exit(1);
              }
            });
          });

          req.on('error', (e) => {
            console.error(e);
            process.exit(1);
          });

          req.write(data);
          req.end();
          EOF

          node run_audit.js

      - name: Post Audit Comment to PR
        if: ${{ steps.get-changed-files.outputs.files != '' }}
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          PR_NUMBER: ${{ github.event.pull_request.number }}
        run: |
          if [ -f audit_report.md ]; then
            gh pr comment $PR_NUMBER --body-file audit_report.md
          fi
