{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plotpickle.local/schemas/rc4/manifest.schema.json",
  "title": "PlotPickle RC4 Manifest",
  "type": "object",
  "required": ["formatVersion", "projectId", "title", "author", "createdAt", "modifiedAt", "minimumPlotPickleVersion", "sdkApiVersion", "schemas"],
  "properties": {
    "formatVersion": { "const": "1.0.0" },
    "projectId": { "type": "string", "format": "uuid" },
    "title": { "type": "string", "minLength": 1 },
    "author": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "modifiedAt": { "type": "string", "format": "date-time" },
    "minimumPlotPickleVersion": { "type": "string", "minLength": 1 },
    "sdkApiVersion": { "type": "string", "minLength": 1 },
    "schemas": {
      "type": "object",
      "required": ["project", "canon", "timeline", "character", "world", "screenplay", "storyboard"],
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "path"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "^extensions/" },
          "optional": { "type": "boolean", "default": true }
        },
        "additionalProperties": true
      },
      "default": []
    }
  },
  "additionalProperties": true
}
