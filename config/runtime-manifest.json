{
  "schemaVersion": 1,
  "authority": "plotpickle-runtime-supervisor",
  "productionPolicy": {
    "allowPathFallback": false,
    "developerOverrides": "explicit-only",
    "defaultListenerHost": "127.0.0.1",
    "hideManagedConsoles": true,
    "preserveProjectAndIdentityState": true
  },
  "components": [
    {
      "id": "plotpickle-app-runtime",
      "displayName": "PlotPickle Application Runtime",
      "version": "workspace",
      "launchStrategy": "current-process",
      "platforms": ["windows", "macos", "linux"],
      "stageLocation": "application",
      "launcher": null,
      "healthProbe": { "kind": "host-owned", "target": "application-runtime" },
      "readinessProbe": { "kind": "host-owned", "target": "application-ready" },
      "startupDependencies": [],
      "startupTimeoutMs": 30000,
      "shutdown": { "strategy": "host-lifecycle" },
      "restartPolicy": "never",
      "capabilities": ["learn", "plan", "build", "settings"],
      "updatePolicy": "application-release",
      "source": { "name": "PlotPickle", "license": "AGPL-3.0-or-later" },
      "developerOverride": "not-applicable",
      "enabled": true
    },
    {
      "id": "buzz-bridge",
      "displayName": "BUZZ Community Bridge",
      "version": "workspace",
      "launchStrategy": "in-process-gateway",
      "platforms": ["windows", "macos", "linux"],
      "stageLocation": "application",
      "launcher": null,
      "healthProbe": { "kind": "host-owned", "target": "buzz-connection" },
      "readinessProbe": { "kind": "host-owned", "target": "buzz-community-ready" },
      "startupDependencies": ["plotpickle-app-runtime"],
      "startupTimeoutMs": 30000,
      "shutdown": { "strategy": "host-lifecycle" },
      "restartPolicy": "never",
      "capabilities": ["community"],
      "updatePolicy": "application-release",
      "source": { "name": "PlotPickle BUZZ bridge", "license": "AGPL-3.0-or-later" },
      "developerOverride": "not-applicable",
      "enabled": true
    },
    {
      "id": "comfyui-engine",
      "displayName": "Managed ComfyUI Engine",
      "version": "adapter-managed",
      "launchStrategy": "managed-script",
      "platforms": ["windows"],
      "stageLocation": "user-managed-engine",
      "launcher": "scripts/start-comfyui-background.ps1",
      "healthProbe": { "kind": "http-loopback", "target": "http://127.0.0.1:8188/system_stats" },
      "readinessProbe": { "kind": "host-owned", "target": "comfyui-model-workflow-ready" },
      "startupDependencies": ["plotpickle-app-runtime"],
      "startupTimeoutMs": 120000,
      "shutdown": { "strategy": "managed-process-tree" },
      "restartPolicy": "on-failure",
      "capabilities": ["image-generation", "video-generation"],
      "updatePolicy": "explicit-adapter-validation",
      "source": { "name": "ComfyUI", "license": "GPL-3.0" },
      "developerOverride": "explicit-only",
      "enabled": true
    },
    {
      "id": "plotpickle-node-service",
      "displayName": "PlotPickle Compute Node Service",
      "version": "future",
      "launchStrategy": "future-managed-service",
      "platforms": ["windows", "macos", "linux"],
      "stageLocation": "application-data",
      "launcher": null,
      "healthProbe": { "kind": "host-owned", "target": "node-process" },
      "readinessProbe": { "kind": "host-owned", "target": "node-authorized-and-opted-in" },
      "startupDependencies": ["plotpickle-app-runtime"],
      "startupTimeoutMs": 30000,
      "shutdown": { "strategy": "managed-process-tree" },
      "restartPolicy": "on-failure",
      "capabilities": ["remote-compute"],
      "updatePolicy": "application-release",
      "source": { "name": "PlotPickle", "license": "AGPL-3.0-or-later" },
      "developerOverride": "explicit-only",
      "enabled": false
    }
  ]
}
