      "targetMap": {"adaptive-context-strategies.ts":"lib/agents/context/adaptive-context-strategies.ts","adaptive-context-strategy-core.mjs":"lib/agents/context/adaptive-context-strategy-core.mjs","agent-orchestration.ts":"lib/agents/agent-orchestration.ts","agent-profiles.ts":"lib/agents/agent-profiles.ts","agent-window-status.mjs":"lib/agents/agent-window-status.mjs"},
      "mode": "retire-bridge",
