{
  "schemaVersion": 1,
  "issue": 2159,
  "contractId": "skin-v1-surface-grammar-v1",
  "experienceContractId": "matrix-experience-surface-v1",
  "designSystem": "skin-v1-matrix",
  "referenceSurface": "dashboard",
  "tokenSource": "app/skin-v1-definition.css",
  "standardShellSource": "app/skin-v1-standard-surface-shell.css",
  "standardHeaderSource": "app/skin-v1-bbs-surfaces.css",
  "surfaceClasses": [
    "reference",
    "directory",
    "workspace",
    "nested",
    "public-exception"
  ],
  "capturePolicies": [
    "standard",
    "census-only",
    "public-exception"
  ],
  "governanceStates": [
    "reference",
    "candidate",
    "census",
    "exception"
  ],
  "rules": {
    "standardHeader": {
      "requiredFor": [
        "directory",
        "workspace",
        "nested"
      ],
      "selectors": [
        ".pp-skin-v1-bar",
        ".pp-skin-v1-title[data-skin-v1-standard-header='true']"
      ],
      "leftText": "PLOTPICKLE",
      "centerRole": "surface-name",
      "rightText": "SKIN V1",
      "minHeightPx": 42,
      "duplicateHeadersAllowed": false,
      "sourceIssue": 2032
    },
    "returnAction": {
      "requiredFor": [
        "directory",
        "workspace",
        "nested"
      ],
      "exemptSurfaceIds": [
        "dashboard"
      ],
      "selector": ".pp-skin-v1-return",
      "containerSelectors": [
        ".pp-skin-v1-surface-actions",
        ".pp-skin-v1-bbs-banner",
        ".pp-skin-v1-profile-banner"
      ],
      "placement": "below-standard-header",
      "horizontalAlignment": "right",
      "cssJustifyContent": "flex-end",
      "textTransform": "none"
    },
    "shellMeasure": {
      "token": "--pp-skin-shell-max",
      "currentMaxPx": 1180,
      "desktopViewportInsetPx": 40,
      "standardExpression": "min(var(--pp-skin-shell-max), calc(100vw - 40px))"
    },
    "spacing": {
      "unitPx": 4,
      "tokenPrefix": "--pp-skin-space-",
      "allowedTokenValuesPx": [
        4,
        8,
        12,
        16,
        20,
        24,
        28,
        32,
        36
      ],
      "structuralPaddingMustUseGrid": true
    },
    "geometry": {
      "radiusToken": "--pp-skin-radius",
      "currentRadiusPx": 0,
      "borderThinToken": "--pp-skin-border-thin",
      "currentBorderThinPx": 1,
      "borderStrongToken": "--pp-skin-border-strong",
      "currentBorderStrongPx": 2,
      "squareStandard": true,
      "borderEmphasisToken": "--pp-skin-border-emphasis",
      "currentBorderEmphasisPx": 3
    },
    "controls": {
      "heightToken": "--pp-skin-control-height",
      "currentHeightPx": 34,
      "touchTargetToken": "--pp-skin-touch-target",
      "currentTouchTargetPx": 44
    },
    "palette": {
      "tokenPrefix": "--pp-skin-",
      "localStructuralPaletteAllowed": false,
      "semanticStateExceptionsAllowed": true
    },
    "panelTreatment": {
      "standardBorderTokens": [
        "--pp-skin-border-thin",
        "--pp-skin-border-strong"
      ],
      "standardLineTokens": [
        "--pp-skin-line",
        "--pp-skin-line-soft",
        "--pp-skin-line-strong",
        "--pp-skin-accent"
      ],
      "standardFillTokens": [
        "--pp-skin-fill-panel",
        "--pp-skin-fill-header",
        "--pp-skin-fill-accent-header",
        "--pp-skin-surface-0",
        "--pp-skin-surface-1",
        "--pp-skin-accent-deep"
      ]
    },
    "screenshotRole": {
      "primaryConsistencyAuthority": false,
      "purpose": "secondary regression evidence after deterministic geometry, token and structure checks"
    }
  },
  "profileContract": {
    "issue": 2226,
    "phase": 2,
    "authority": "config/skin-v1-surface-grammar.json",
    "censusEvidence": "docs/architecture/skin-v1-surface-blueprint-phase-0-census.md",
    "dashboardMeasureDecision": "human-approved-phase-3",
    "shellLevelFourColumnArchetype": false
  },
  "layoutArchetypes": {
    "one-column": {
      "primaryStructure": "single dominant content column",
      "censusEvidence": "one-column content/action/configuration/history/workspace surfaces"
    },
    "two-column": {
      "primaryStructure": "dominant content plus secondary column",
      "censusEvidence": "Profile and current two-column surfaces"
    },
    "three-column": {
      "primaryStructure": "three coordinated workspace columns",
      "censusEvidence": "existing three-column workspaces",
      "standardSurfaceAssignmentsRequired": false
    },
    "directory-grid": {
      "primaryStructure": "directory or adaptive card/grid browsing",
      "censusEvidence": "Dashboard, Library, Writer's Craft and current directories"
    },
    "editor-inspector": {
      "primaryStructure": "dominant editor with inspector/evidence region",
      "censusEvidence": "Write and PageFlow"
    },
    "timeline-workspace": {
      "primaryStructure": "workspace with time-oriented nested projection",
      "censusEvidence": "Scene Workspace inside Storyboard / Visual Story"
    },
    "canvas-visual-workspace": {
      "primaryStructure": "visual/canvas workspace",
      "censusEvidence": "Story Map, Storyboard, Visual Story and Previs"
    },
    "settings-directory": {
      "primaryStructure": "configuration directory with capability/detail regions",
      "censusEvidence": "Local, Cloud, Hybrid and Agents"
    }
  },
  "bodyMeasureProfiles": {
    "dashboard-reference-current": {
      "policy": "preserve locked rendered Dashboard measure until Phase 3",
      "explicitHumanApprovalRequiredToChange": true
    },
    "standard-shell": {
      "token": "--pp-skin-shell-max",
      "maxPx": 1180,
      "desktopViewportInsetPx": 40,
      "expression": "min(var(--pp-skin-shell-max), calc(100vw - 40px))",
      "humanApprovedPhase": 3,
      "workspaceFullShellAllowed": true
    },
    "canonical-directory": {
      "token": "--pp-skin-shell-max",
      "maxPx": 1180,
      "desktopViewportInsetPx": 40,
      "expression": "min(var(--pp-skin-shell-max), calc(100vw - 40px))",
      "innerToken": "--pp-skin-menu-max",
      "innerMaxPx": 1060,
      "innerExpression": "min(var(--pp-skin-menu-max), calc(100% - 72px))",
      "humanApprovedPhase": 3
    }
  },
  "headerProfiles": {
    "dashboard-reference": {
      "policy": "Human-approved Phase 3 Dashboard composition retained inside the canonical shell"
    },
    "standard": {
      "sourceRule": "rules.standardHeader",
      "required": true
    },
    "restrained-subheader": {
      "sourceEvidence": "Issue Log",
      "treatment": "standard header plus restrained green left-edge/eyebrow subordinate treatment",
      "mayReplaceStandardHeader": false
    }
  },
  "footerProfiles": {
    "standard-status": {
      "required": true,
      "role": "surface status/context footer",
      "localDesignAuthorityAllowed": false
    },
    "workspace-context": {
      "required": true,
      "role": "project/workspace context and status footer",
      "localDesignAuthorityAllowed": false
    },
    "dashboard-reference": {
      "policy": "Human-approved Phase 3 Dashboard status/footer composition retained inside the canonical shell"
    }
  },
  "returnProfiles": {
    "none-reference": {
      "required": false,
      "allowedSurfaceIds": [
        "dashboard"
      ]
    },
    "upper-right-parent": {
      "required": true,
      "selector": ".pp-skin-v1-return",
      "horizontalAlignment": "right",
      "placement": "below-standard-header",
      "destination": "canonical parent"
    },
    "upper-right-origin-aware": {
      "required": true,
      "selector": ".pp-skin-v1-return",
      "horizontalAlignment": "right",
      "placement": "below-standard-header",
      "destination": "canonical origin/parent"
    }
  },
  "frameProfiles": {
    "solid-standard": {
      "borderStyle": "solid",
      "outerBorderToken": "--pp-skin-border-thin",
      "innerBorderToken": "--pp-skin-border-thin",
      "lineTokens": [
        "--pp-skin-line",
        "--pp-skin-line-soft",
        "--pp-skin-line-strong",
        "--pp-skin-accent"
      ],
      "humanAmendment": "2026-09-18 standard neutral perimeter reduced to 1px; 2px retained for semantic emphasis"
    },
    "layered-inset": {
      "borderStyle": "solid",
      "sourceEvidence": "Profile",
      "outerBorderToken": "--pp-skin-border-strong",
      "insetBorderToken": "--pp-skin-border-thin",
      "localRadiusAllowed": false,
      "insetLineToken": "--pp-skin-line",
      "fillToken": "--pp-skin-fill-panel",
      "insetHighlightToken": "--pp-skin-inset-highlight",
      "humanApprovedPhase": 3
    }
  },
  "selectedStateProfiles": {
    "canonical-dark-accent": {
      "sourceEvidence": [
        "Local Story Mode",
        "Settings directory",
        "Dashboard current selected row"
      ],
      "backgroundToken": "--pp-skin-accent-deep",
      "borderWidthToken": "--pp-skin-border-thin",
      "borderColorToken": "--pp-skin-accent-bright",
      "textToken": "--pp-skin-ink",
      "starkWhiteFillAllowed": false
    },
    "not-applicable": {
      "required": false
    }
  },
  "typographyProfiles": {
    "standard-ui": {
      "fontToken": "--pp-skin-font-ui",
      "brandFontToken": "--pp-skin-font-brand",
      "localFontFamilyAllowed": false,
      "canonicalFamily": "JetBrains Mono",
      "ligatures": "none",
      "selfHostedAssetManifest": "public/fonts/jetbrains-mono/manifest.json",
      "singleFontFamily": true,
      "brandFamilyExceptionAllowed": false,
      "semanticRoleAuthority": "config/skin-v1-surface-composition-reference.json#typography.semanticRoles"
    },
    "project-workspace": {
      "fontToken": "--pp-skin-font-ui",
      "brandFontToken": "--pp-skin-font-brand",
      "localFontFamilyAllowed": false,
      "projectAwareTitleAllowed": true,
      "hardCodedProjectNameAllowed": false,
      "canonicalFamily": "JetBrains Mono",
      "ligatures": "none",
      "selfHostedAssetManifest": "public/fonts/jetbrains-mono/manifest.json",
      "singleFontFamily": true,
      "brandFamilyExceptionAllowed": false,
      "semanticRoleAuthority": "config/skin-v1-surface-composition-reference.json#typography.semanticRoles"
    }
  },
  "semanticBorderExceptions": [
    {
      "id": "disabled-control-dashed",
      "selector": ".pp-skin-v1-panel button:disabled",
      "borderStyle": "dashed",
      "semanticState": "disabled/unavailable",
      "source": "app/skin-v1.css",
      "structuralFrameException": false
    },
    {
      "id": "premium-emphasis-edge",
      "selector": "[data-skin-emphasis='premium']",
      "borderStyle": "solid",
      "widthToken": "--pp-skin-border-emphasis",
      "placement": "edge-only",
      "semanticState": "premium/high-priority",
      "structuralFrameException": false,
      "source": "config/skin-v1-surface-composition-reference.json"
    }
  ],
  "borderPolicy": {
    "structuralStyles": [
      "solid"
    ],
    "dottedStructuralBordersAllowed": false,
    "dashedStructuralBordersAllowed": false,
    "exceptionRegistry": "semanticBorderExceptions",
    "semanticEmphasisMaxPx": 3,
    "threePixelStructuralFramesAllowed": false
  },
  "shellProfiles": {
    "dashboard-reference": {
      "header": "dashboard-reference",
      "footer": "dashboard-reference",
      "return": "none-reference",
      "bodyMeasure": "canonical-directory",
      "frame": "layered-inset"
    },
    "standard": {
      "header": "standard",
      "footer": "standard-status",
      "return": "upper-right-parent",
      "bodyMeasure": "standard-shell",
      "frame": "solid-standard"
    },
    "standard-restrained": {
      "header": "restrained-subheader",
      "footer": "standard-status",
      "return": "upper-right-parent",
      "bodyMeasure": "standard-shell",
      "frame": "solid-standard"
    },
    "library-family": {
      "header": "standard",
      "footer": "standard-status",
      "return": "upper-right-parent",
      "bodyMeasure": "standard-shell",
      "frame": "solid-standard",
      "family": "library"
    },
    "production": {
      "header": "standard",
      "footer": "workspace-context",
      "return": "upper-right-parent",
      "bodyMeasure": "standard-shell",
      "frame": "solid-standard",
      "projectAware": true
    },
    "production-nested": {
      "header": "standard",
      "footer": "workspace-context",
      "return": "upper-right-parent",
      "bodyMeasure": "standard-shell",
      "frame": "solid-standard",
      "projectAware": true,
      "nested": true
    },
    "settings": {
      "header": "standard",
      "footer": "standard-status",
      "return": "upper-right-parent",
      "bodyMeasure": "standard-shell",
      "frame": "solid-standard",
      "family": "settings"
    },
    "diagnostic": {
      "header": "standard",
      "footer": "workspace-context",
      "return": "upper-right-origin-aware",
      "bodyMeasure": "standard-shell",
      "frame": "solid-standard",
      "projectAware": true
    },
    "action": {
      "header": "standard",
      "footer": "standard-status",
      "return": "upper-right-parent",
      "bodyMeasure": "standard-shell",
      "frame": "solid-standard",
      "centeredPrimaryAction": true
    }
  },
  "canonicalShellDecision": {
    "issue": 2226,
    "phase": 3,
    "approval": "human-approved",
    "approvalDate": "2026-09-18",
    "outerShellMaxPx": 1180,
    "desktopViewportInsetPx": 40,
    "desktopGutterPerSidePx": 20,
    "directoryBodyMaxPx": 1060,
    "directoryBodyToken": "--pp-skin-menu-max",
    "directoryFallbackExpression": "calc(100% - 72px)",
    "workspaceFullShellAllowed": true,
    "outerFrame": {
      "widthToken": "--pp-skin-border-strong",
      "widthPx": 2,
      "style": "solid",
      "lineToken": "--pp-skin-line-strong"
    },
    "insetFrame": {
      "widthToken": "--pp-skin-border-thin",
      "widthPx": 1,
      "style": "solid",
      "lineToken": "--pp-skin-line"
    },
    "radiusToken": "--pp-skin-radius",
    "radiusPx": 0,
    "matteFillToken": "--pp-skin-fill-panel",
    "selectedStateProfile": "canonical-dark-accent",
    "baselineReplacement": "requires-separate-human-acceptance-of-resulting-dashboard-candidate"
  },
  "compositionReference": "config/skin-v1-surface-composition-reference.json",
  "anatomyContract": "config/skin-v1-surface-anatomy-contract.json",
  "specSheetContract": "config/skin-v1-spec-sheet-contract.json",
  "surfaceDeclarations": "config/skin-v1-surface-declarations/*.json"
}
