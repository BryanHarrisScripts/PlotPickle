{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plotpickle.app/schema/plotpickle-project.schema.json",
  "title": "PlotPickle Project",
  "description": "Canonical local-first story project shared by every PlotPickle workspace.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "metadata",
    "story",
    "world",
    "development",
    "screenplay",
    "structure",
    "characters",
    "blocks"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.6.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "story": {
      "$ref": "#/$defs/story"
    },
    "world": {
      "$ref": "#/$defs/world"
    },
    "development": {
      "$ref": "#/$defs/development"
    },
    "screenplay": {
      "$ref": "#/$defs/screenplay"
    },
    "structure": {
      "$ref": "#/$defs/structure"
    },
    "characters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/character"
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/block"
      }
    }
  },
  "$defs": {
    "screenplay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fileName",
        "format",
        "sourceText",
        "importedAt",
        "analysisStatus",
        "analyzedAt",
        "suggestedFields",
        "draftElements"
      ],
      "properties": {
        "fileName": {
          "type": "string"
        },
        "format": {
          "enum": [
            "plain-text",
            "fountain",
            "final-draft"
          ]
        },
        "sourceText": {
          "type": "string"
        },
        "importedAt": {
          "type": "string"
        },
        "analysisStatus": {
          "enum": [
            "none",
            "suggested",
            "reviewed"
          ]
        },
        "analyzedAt": {
          "type": "string"
        },
        "suggestedFields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "draftElements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/screenplayDraftElement"
          }
        }
      }
    },
    "screenplayDraftElement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "text",
        "blockNumber",
        "miniBlockNumber",
        "sceneNumber",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "scene-heading",
            "action",
            "character",
            "parenthetical",
            "dialogue",
            "transition"
          ]
        },
        "text": {
          "type": "string"
        },
        "blockNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "miniBlockNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "sceneNumber": {
          "type": "integer",
          "minimum": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sceneId": {
          "type": "string"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "subtitle",
        "format",
        "targetMinutes",
        "genre",
        "tone",
