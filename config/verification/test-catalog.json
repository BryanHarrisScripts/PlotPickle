{
  "$schema": "../../schema/verification/test-catalog.schema.json",
  "schemaVersion": "1.0",
  "sourceArchitecture": "architecture/plotpickle.architecture.json",
  "migrationSource": "config/verification/phase-0-inventory.json",
  "entries": [
    {
      "id": "experience.webmcp-live-observer",
      "ownerLayer": "experience-skins",
      "architectureComponents": ["webmcp-live-observer", "skin-surface-readiness", "experience-navigation"],
      "triggerTokens": ["mcp", "navigation", "skin", "surface", "visual"],
      "runner": {
        "kind": "browser-uat",
        "targets": ["scripts/verification-webmcp-live.mjs"]
      },
      "cost": "medium",
      "modes": ["impact"],
      "platforms": ["linux"],
      "requirements": {
        "network": true,
        "native": false,
        "secrets": false
      },
      "evidence": {
        "types": ["rendered-uat", "screenshot", "report"],
        "artifactPaths": [
          ".artifacts/verification-live/webmcp-live.json",
          ".artifacts/webmcp-startup/summary.json",
          ".artifacts/webmcp-startup/uat-findings.json",
          ".artifacts/visual-readiness/dashboard-canonical.png",
          ".artifacts/visual-readiness/visual-director-report.json"
        ]
      },
      "notes": "Phase 5 live read-only WebMCP observer. It is single-owned by Experience Skins but can be selected by Skin, Experience surface/navigation, or WebMCP verifier risk tokens. Network permission is limited to repository dependencies plus pinned Playwright/WebMCP verification tooling; no external AI provider calls or secrets are permitted."
    },
    {
      "id": "provider.local-ai-plugin-registry",
      "ownerLayer": "provider-runtime",
      "architectureComponents": ["local-ai-plugin-registry", "provider-runtime"],
      "triggerTokens": ["plugin", "provider", "video"],
      "runner": {
        "kind": "node-test",
        "targets": ["tests/local-ai-plugin-registry.test.mjs"]
      },
      "cost": "fast",
      "modes": ["baseline", "impact"],
      "platforms": ["any"],
      "requirements": {
        "network": false,
        "native": false,
        "secrets": false
      },
      "evidence": {
        "types": ["test-result", "report"],
        "artifactPaths": [".artifacts/verification-shadow/provider-runtime.json", ".artifacts/verification-shadow/provider-runtime.comparison.json"]
      },
      "notes": "Phase 4 primary execution owner for the pure local-AI plug-in registry contract. Replaces duplicate execution of this target in PR Gate and Product Gate; the heavier LTX contract remains in both legacy gates until separately proven."
    },
    {
      "id": "verification.phase2-core",
      "ownerLayer": "verification",
      "architectureComponents": ["verification-core"],
      "triggerTokens": ["test-harness", "cli"],
      "runner": {
        "kind": "node-test",
        "targets": ["tests/issue-1938-verification-core.test.mjs"]
      },
      "cost": "fast",
      "modes": ["baseline", "impact"],
      "platforms": ["any"],
      "requirements": {
        "network": false,
        "native": false,
        "secrets": false
      },
      "evidence": {
        "types": ["test-result", "report"],
        "artifactPaths": [".artifacts/verification/verification.json"]
      },
      "notes": "Phase 2 self-test for the shared verification planning/execution/evidence core. Existing PR Gate and Product Gate remain authoritative."
    }
  ]
}
