  "canonicalFieldIdentity": {
    "learnBackedField": "<topic>:<lessonId>:<fieldId>",
    "projectArtifact": "<topic>:artifact:<artifactId>",
    "rules": [
      "A canonical field key is stable across Mind Map and World Map.",
      "Mind Map and World Map may render the same field differently but may not own separate values.",
      "Existing Foundations and World field ids already use <topic>:<lessonId>:<fieldId> in Story Bible projection and are the compatibility baseline.",
      "Instructional-only Learn material must be marked instructional-only instead of manufacturing a project value."
    ]
  },
