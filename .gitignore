# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# PlotPickle local installation and user state
/.plotpickle/
/projects/
/user-data/
/backups/
/logs/
/credentials/
credentials.json

# testing and generated reports
/coverage
/reports/lighthouse/

# next.js and build output
/.next/
/out/
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/

