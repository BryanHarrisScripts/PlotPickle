{
  "schemaVersion": 1,
  "packageUri": "skill://plotpickle/writer-in-residence",
  "packageVersion": "1.0.0",
  "selection": {
    "mode": "on-demand",
    "maxSpecialistsPerTurn": 2,
    "authority": "Specialist procedures may shape analysis or proposals only. They never grant tools, network access, provider choice, PPF mutation, developer authority or final creative authority."
  },
  "specialists": [
    {
      "id": "story-structure",
      "displayName": "Story Structure Specialist",
      "purpose": "Inspect causal structure, escalation, scene function and 24/96-block alignment without rewriting canon by default.",
      "reference": ".agents/skills/writer-in-residence/references/specialists/story-structure.md",
      "outputContract": ["observations", "specific evidence", "optional proposal", "open question"],
      "keywords": ["structure", "block", "beat", "act", "scene", "escalation", "causal", "pacing"]
    },
    {
      "id": "character-continuity",
      "displayName": "Character & Continuity Specialist",
      "purpose": "Check character motivation, voice, relationship state, chronology and continuity against supplied project context.",
      "reference": ".agents/skills/writer-in-residence/references/specialists/character-continuity.md",
      "outputContract": ["continuity finding", "source evidence", "severity", "optional repair proposal"],
      "keywords": ["character", "voice", "motivation", "continuity", "timeline", "relationship", "arc"]
    },
    {
      "id": "scene-revision",
      "displayName": "Scene Revision Specialist",
      "purpose": "Produce bounded revision candidates for a writer-selected scene or excerpt while preserving accepted material and provenance.",
      "reference": ".agents/skills/writer-in-residence/references/specialists/scene-revision.md",
      "outputContract": ["before intent", "proposed revision", "what changed", "what was preserved"],
      "keywords": ["rewrite", "revise", "dialogue", "scene", "excerpt", "line", "tighten", "alternative"]
    },
    {
      "id": "visual-continuity",
      "displayName": "Visual Continuity Specialist",
      "purpose": "Review visual direction, character/location identity, shot intent and asset continuity using only supplied references and rendered evidence.",
      "reference": ".agents/skills/writer-in-residence/references/specialists/visual-continuity.md",
      "outputContract": ["visual finding", "evidence", "continuity risk", "optional direction proposal"],
      "keywords": ["visual", "image", "storyboard", "shot", "location", "look", "costume", "continuity"]
    },
    {
      "id": "reader-review",
      "displayName": "Fresh Reader Specialist",
      "purpose": "React as a fresh reader to clarity, emotional effect, confusion and unanswered questions without silently converting taste into canon.",
      "reference": ".agents/skills/writer-in-residence/references/specialists/reader-review.md",
      "outputContract": ["reader reaction", "confusion", "strongest moment", "question for writer"],
      "keywords": ["read", "review", "reaction", "confusing", "emotion", "feedback", "fresh eyes"]
    }
  ]
}
