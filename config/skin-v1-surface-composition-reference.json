  "spacing": {
    "baseUnitPx": 4,
    "tokens": {
      "4": "--pp-skin-space-1",
      "8": "--pp-skin-space-2",
      "12": "--pp-skin-space-3",
      "16": "--pp-skin-space-4",
      "20": "--pp-skin-space-5",
      "24": "--pp-skin-space-6",
      "28": "--pp-skin-space-7",
      "32": "--pp-skin-space-8",
      "36": "--pp-skin-space-9"
    },
    "rule": "All structural gap, padding and margin values use the four-pixel Skin V1 spacing grid."
  },
  "bordersAndFrames": {
    "onePixel": {
      "token": "--pp-skin-border-thin",
      "px": 1,
      "roles": [
        "inset-frame",
        "panel-border",
        "menu-row-border",
        "control-border",
        "divider",
        "focus-outline",
        "eyebrow-accent-edge"
