  "pillPatterns": {
    "note": "Pill means compact repeated control/status item. Skin V1 pills remain square; no capsule radius is introduced.",
    "oneColumnStack": {
      "columns": 1,
      "display": "grid",
      "template": "minmax(0, 1fr)",
      "gapToken": "--pp-skin-space-2"
    },
    "oneRowWrap": {
      "columns": "auto-wrap",
      "display": "flex",
      "flexWrap": "wrap",
      "gapToken": "--pp-skin-space-2"
    },
    "twoColumnGrid": {
      "columns": 2,
      "display": "grid",
      "template": "repeat(2, minmax(0, 1fr))",
      "gapToken": "--pp-skin-space-2",
      "collapseTo": "oneColumnStack"
    },
    "threeColumnGrid": {
      "columns": 3,
      "display": "grid",
      "template": "repeat(3, minmax(0, 1fr))",
      "gapToken": "--pp-skin-space-2",
      "collapseSequence": [
        "twoColumnGrid",
        "oneColumnStack"
      ]
    },
    "styling": {
      "borderWidthToken": "--pp-skin-border-thin",
      "borderColorToken": "--pp-skin-line",
      "backgroundToken": "--pp-skin-surface-1",
      "textToken": "--pp-skin-ink-soft",
      "selectedBackgroundToken": "--pp-skin-accent-deep",
      "selectedBorderColorToken": "--pp-skin-accent-bright",
      "selectedTextToken": "--pp-skin-ink",
      "radiusPx": 0
    }
  },
