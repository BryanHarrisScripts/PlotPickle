{
  "schemaVersion": 1,
  "issue": 2226,
  "id": "skin-v1-surface-composition-reference-v1",
  "status": "human-review-reference",
  "purpose": "One machine-readable wrapper reference for visibly composing every governed Skin V1 surface from the existing token, grammar and registry authorities.",
  "authority": {
    "parentProductStandard": "docs/UI-UX-DESIGN-STANDARD.md",
    "tokenSource": "app/skin-v1-definition.css",
    "grammarSource": "config/skin-v1-surface-grammar.json",
    "registrySource": "config/skin-v1-surface-registry.json",
    "canonicalVisualReference": "dashboard",
    "mayCreateSecondDesignSystem": false,
    "mayOverrideTokensLocally": false,
    "mayInventNewShellArchetypes": false,
    "shellLevelFourColumnAllowed": false
  },
  "canonicalWrapperOrder": [
    "global-header",
    "surface-action-row",
    "outer-shell-frame",
    "workspace-header",
    "eyebrow-or-subheader",
    "content-layout",
    "status-or-context-footer"
