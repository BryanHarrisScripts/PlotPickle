{
  "schemaVersion": 1,
  "id": "openpencil",
  "label": "OpenPencil",
  "role": "optional-programmable-ux-design-workspace",
  "source": "https://github.com/open-pencil/open-pencil",
  "license": "MIT",
  "userManaged": false,
  "autoInstall": true,
  "launchOnPlotPickleStartup": false,
  "requiredForPlotPickleStartup": false,
  "localOnlyDefault": true,
  "workspaceScope": {
    "required": true,
    "environment": "OPENPENCIL_MCP_ROOT",
    "default": "<repo>\\designs\\openpencil",
    "repositoryTracked": true,
    "policy": "Automation may inspect or write design files only inside the explicitly scoped design workspace. After an explicit Human OpenPencil session, a saved registered design delta may be committed automatically to an isolated design-review branch; protected main and implementation merge remain Human/GitHub governed."
  },
  "cli": {
    "executable": "openpencil",
    "jsonOutputSupported": true,
    "readCommands": [
      "info",
      "tree",
      "find",
      "query",
      "analyze",
      "variables"
    ],
    "writeCommandsRequireHumanAction": [
      "eval -w",
      "convert",
      "import",
      "export"
    ],
    "managedPackage": "@open-pencil/cli",
    "managedVersion": "0.16.0",
    "appControl": [
      "documents list",
      "documents open",
      "documents activate"
    ]
  },
  "mcp": {
    "stdioExecutable": "openpencil-mcp",
    "httpExecutable": "openpencil-mcp-http",
    "defaultTransport": "stdio",
    "writeToolsRequireHumanAction": true,
    "cloudProviderUse": "never-implicit",
    "plotPickleTransport": "http",
    "plotPickleEndpoint": "http://127.0.0.1:7600/mcp",
    "connectSurface": "Settings > Command",
    "explicitConnectRequired": true,
    "ownedChildOnly": true
  },
  "authority": {
    "designAuthority": "plotpickle-skin-and-ui-contracts",
    "developmentAuthority": "human-dsdd-github",
    "sourceMutationAllowed": false,
    "mergeAuthority": false,
    "webmcpReplacement": false
  },
  "firstProof": {
    "issue": 2778,
    "surface": "Timeline",
    "scenario": "I have 25 approved Storyboard images and want to turn them into 25 three-second moving shots, review them, and watch the Mini-Block as a coherent sequence.",
    "workflow": [
      "script",
      "shot-intent",
      "approved-first-frame",
      "motion-direction",
      "generate-motion",
      "review",
      "keep-or-redo",
      "next-shot"
    ]
  },
  "command": {
    "surface": "Settings > Command",
    "operationalVerbs": [
      "OpenPencil help",
      "OpenPencil open <surface name>",
      "OpenPencil review <surface name>",
      "OpenPencil publish <surface name>",
      "OpenPencil status",
      "OpenPencil connect <absolute local design workspace>",
      "OpenPencil disconnect"
    ],
    "entersDsddBriefFlow": false,
    "sourceMutationAuthority": false,
    "contextAwareSurfaceInference": false,
    "reviewHandoff": {
      "flow": [
        "Review Design Changes",
        "Interpret",
        "Pi Draft",
        "Publish Brief"
      ],
      "delivery": "github-issue",
      "implementationPullRequest": false
    },
    "autoDesignReview": {
      "issue": 2800,
      "trigger": "saved-delta-after-explicit-open-and-return",
      "branchPattern": "design/openpencil/<surface>-<sha256-prefix>",
      "protectedMainPush": false,
      "implementationPullRequest": false,
      "duplicatePolicy": "content-hash-idempotent",
      "retryCommand": "OpenPencil publish <surface name>"
    }
  },
  "connectionProof": {
    "issue": 2782,
    "normalStartupLaunch": false,
    "packageInstall": "plotpickle-managed-after-core-ready",
    "pinnedVersion": "0.16.0",
    "windowsShell": false,
    "endpointHost": "127.0.0.1",
    "endpointPort": 7600,
    "defaultWorkspace": "<repo>\\designs\\openpencil"
  },
  "managedPackage": {
    "name": "@open-pencil/mcp",
    "version": "0.16.0",
    "installTiming": "after-core-ready",
    "installRoot": "%LOCALAPPDATA%\\PlotPickle\\tools\\openpencil",
    "failurePolicy": "warn-and-continue",
    "launchesServer": false,
    "companionCli": "@open-pencil/cli",
    "companionCliVersion": "0.16.0"
  },
  "gui": {
    "version": "0.16.0",
    "platform": "windows",
    "explicitSurfaceRequired": true,
    "surfaceRegistry": "designs/openpencil/surfaces.json",
    "launchOnPlotPickleStartup": false,
    "command": "OpenPencil open <surface name>",
    "desktopExecutable": "OpenPencil.exe",
    "approvedOverride": "PLOTPICKLE_OPENPENCIL_DESKTOP_EXE",
    "installer": {
      "url": "https://github.com/open-pencil/open-pencil/releases/download/v0.16.0/OpenPencil_0.16.0_x64-setup.exe",
      "sha256": "1b851ac488ce9be437f8b321cadb87ee169f9a1d11968d8e8be87742c9d4df4b",
      "timing": "after-core-ready",
      "failurePolicy": "warn-and-continue",
      "silentArgument": "/S"
    },
    "designSessionOwner": "openpencil-desktop-gui",
    "normalReviewMode": "visual-gui",
    "headlessCommandsRole": "optional-diagnostics"
  }
}
