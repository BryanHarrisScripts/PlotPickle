.DS_Store
Thumbs.db
*.tmp

# private keys, certificates, signing material and local secrets
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
id_rsa
id_dsa
id_ecdsa
id_ed25519

# debug logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# hosting
.vercel

# typescript
next-env.d.ts
