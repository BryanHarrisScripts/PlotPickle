        "token": "--pp-skin-leading-body",
        "value": 1.55
      }
    },
    "tracking": {
      "meta": {
        "token": "--pp-skin-tracking-meta",
        "value": "0.06em"
      },
      "label": {
        "token": "--pp-skin-tracking-label",
        "value": "0.10em"
      }
    },
    "rules": {
      "oneDominantWorkspaceTitle": true,
      "localFontFamiliesAllowed": false,
      "localTitleScaleAllowed": false,
      "projectAwareWorkspaceTitles": true,
      "hardCodedProjectNamesAllowed": false
    }
  },
  "headers": {
    "global": {
      "textPattern": [
