      "completedTargets": ["lib/agents/context/adaptive-context-strategies.ts","lib/agents/context/adaptive-context-strategy-core.mjs","lib/agents/agent-orchestration.ts","lib/agents/agent-profiles.ts","lib/agents/agent-window-status.mjs"]
    }
  ]
