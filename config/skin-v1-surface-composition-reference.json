        "primary",
        "secondary",
        "tertiary"
      ],
      "sourceEvidence": "existing three-column workspaces",
      "collapseSequence": [
        "twoColumn",
        "oneColumn"
      ]
    },
    "threeColumnWithNestedOneColumn": {
      "columns": 3,
      "outerTemplate": "repeat(3, minmax(0, 1fr))",
      "nestedColumnDisplay": "grid",
      "nestedColumnTemplate": "minmax(0, 1fr)",
      "nestedColumnFlow": "row",
