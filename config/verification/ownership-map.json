{
  "$schema": "../../schema/verification/ownership.schema.json",
  "schemaVersion": "1.0",
  "sourceArchitecture": "architecture/plotpickle.architecture.json",
  "unknownProduction": {
    "policy": "fail-closed",
    "evidenceCode": "unmapped-production-ownership"
  },
  "rules": [
    {
      "id": "experience-skin-v1",
      "classification": "production",
      "include": ["app/skin-v1/**", "app/skin-v1-*.css", "app/skin-v1-definition.css"],
      "ownerLayer": "experience-skins",
      "riskTokens": ["skin", "surface", "navigation", "visual", "mcp"]
    },
    {
      "id": "windows-local-launcher",
      "classification": "production",
      "include": ["GIT-PlotPickle.ps1", "PlotPickle.ps1", "Start-PlotPickle.bat"],
      "ownerLayer": "experience-skins",
      "riskTokens": ["windows", "native", "mcp", "surface"]
    },
    {
      "id": "community-conversation-surface",
      "classification": "production",
      "include": [
        "modules/community/community-buzz-social.tsx",
        "app/_components/community/community-workspace.tsx",
        "app/_components/community/community-private-story-room.tsx",
        "app/_components/community/community-story-room-access.tsx",
        "app/_components/community/community-story-room-access.module.css"
      ],
      "ownerLayer": "experience-skins",
      "riskTokens": ["surface", "navigation", "visual", "mcp"]
    },
    {
      "id": "product-identity-surfaces",
      "classification": "production",
      "include": [
        "lib/product-direction.ts",
        "app/layout.tsx",
        "app/about/**",
        "app/welcome/**",
        "app/marketing-splash-base.tsx",
        "app/profile-access/profile-access-boundary.tsx",
        "public/manifest.webmanifest",
        "public/brand/favicon/plotpickle-green-square.svg"
      ],
      "ownerLayer": "experience-skins",
      "riskTokens": ["surface", "visual", "navigation", "mcp"]
    },
    {
      "id": "experience-surface-registry",
      "classification": "production",
      "include": ["lib/experience/surface-registry.ts"],
      "ownerLayer": "experience-contract",
      "riskTokens": ["surface", "navigation", "mcp"]
    },
    {
      "id": "community-human-ux-contract",
      "classification": "production",
      "include": ["lib/community/community-ux-contract.ts"],
      "ownerLayer": "experience-contract",
      "riskTokens": ["surface", "navigation", "mcp"]
    },
    {
      "id": "community-story-room-access-gateway",
      "classification": "production",
      "include": ["build/buzz-story-room-access-gateway.ts"],
      "ownerLayer": "production-harness",
      "riskTokens": ["authority", "community", "provider"]
    },
    {
      "id": "root-story-startup",
      "classification": "production",
      "include": ["app/page.tsx"],
      "ownerLayer": "experience-contract",
      "riskTokens": ["surface", "navigation", "mcp"]
    },
    {
      "id": "learn-journey-preview-api",
      "classification": "production",
      "include": [
        "app/api/learn/journey-preview/route.ts",
        "app/api/learn/journey-semester-one/route.ts",
        "app/api/learn/journey-courses/route.ts",
        "app/api/learn/explore/route.ts"
      ],
      "ownerLayer": "experience-contract",
      "riskTokens": ["surface", "navigation", "canon"]
    },
    {
      "id": "learn-application-contract",
      "classification": "production",
      "include": [
        "core/contracts/learning-application.ts",
        "core/learning/application-view.ts"
      ],
      "ownerLayer": "experience-contract",
      "riskTokens": ["surface", "canon", "graph"]
    },
    {
      "id": "learn-ea-reflection-agent",
      "classification": "production",
      "include": [
        "core/contracts/curriculum-guide.ts",
        "modules/creative-room/ea-reflection-guide.ts"
      ],
      "ownerLayer": "agent-runtime",
      "riskTokens": ["agent", "canon", "provider"]
    },
    {
      "id": "plotpickle-agent-runtime-contract",
      "classification": "production",
      "include": ["build/agent-runtime-contract.ts"],
      "ownerLayer": "agent-runtime",
      "riskTokens": ["agent", "provider", "canon"]
    },
    {
      "id": "learn-curriculum-content",
      "classification": "production",
      "include": ["learn/*.json", "learn/enrichment/**"],
      "ownerLayer": "story-canon",
      "riskTokens": ["canon", "graph"]
    },
    {
      "id": "learn-curriculum-projection",
      "classification": "production",
      "include": [
        "adapters/curriculum/current-catalog.ts",
        "adapters/curriculum/current-catalog-integrated.ts",
        "adapters/curriculum/issue-1976-canonical.ts"
      ],
      "ownerLayer": "story-canon",
      "riskTokens": ["canon", "graph"]
    },
    {
      "id": "learn-program-map",
      "classification": "production",
      "include": ["learn/program-map.mjs", "learn/program-map-spec.mjs", "learn/current-program-map.mjs"],
      "ownerLayer": "story-canon",
      "riskTokens": ["canon", "graph"]
    },
    {
      "id": "learn-journey-baseline-validator",
      "classification": "verification",
      "include": ["scripts/validate-learn-journey-baseline.mjs"],
      "ownerLayer": "verification",
      "riskTokens": ["canon", "test-harness", "cli"]
    },
    {
      "id": "learn-program-map-validator",
      "classification": "verification",
      "include": ["scripts/validate-learn-program-map.mjs"],
      "ownerLayer": "verification",
      "riskTokens": ["canon", "test-harness", "cli"]
    },
    {
      "id": "learn-curriculum-integrity-harness",
      "classification": "verification",
      "include": [
        "scripts/learn-curriculum-integrity.mjs",
        "scripts/validate-learn-curriculum-integrity.mjs"
      ],
      "ownerLayer": "verification",
      "riskTokens": ["canon", "graph", "test-harness", "cli"]
    },
    {
      "id": "webmcp-live-verifier",
      "classification": "verification",
      "include": [
        "lib/verification/webmcp-*.mjs",
        "lib/verification/skin-v1-menu-contract-audit.mjs",
        "scripts/run-webmcp-startup-uat.mjs",
        "scripts/verification-webmcp-live.mjs"
      ],
      "ownerLayer": "verification",
      "riskTokens": ["surface", "navigation", "visual", "mcp", "test-harness"]
    },
    {
      "id": "verification-contract-files",
      "classification": "verification",
      "include": [
        ".github/workflows/**",
        "config/development-convergence/**",
        "config/verification/**",
        "schema/verification/**",
        "lib/verification/**",
        "scripts/validate-verification-phase-1.mjs",
        "scripts/verification-core.mjs",
        "scripts/verification-shadow.mjs"
      ],
      "ownerLayer": "verification",
      "riskTokens": ["test-harness", "cli"]
    },
    {
      "id": "oss-radar-operations-contract",
      "classification": "verification",
      "include": ["config/oss-radar/**"],
      "ownerLayer": "verification",
      "riskTokens": ["test-harness", "docs"]
    },
    {
      "id": "architecture-blueprint",
      "classification": "docs",
      "include": ["architecture/**"],
      "ownerLayer": "verification",
      "riskTokens": ["docs", "test-harness"]
    },
    {
      "id": "repository-readme",
      "classification": "docs",
      "include": ["README.md"],
      "ownerLayer": "verification",
      "riskTokens": ["docs"]
    },
    {
      "id": "verification-tests",
      "classification": "test",
      "include": ["tests/**"],
      "ownerLayer": "verification",
      "riskTokens": ["test-harness"]
    },
    {
      "id": "verification-docs",
      "classification": "docs",
      "include": ["docs/**"],
      "ownerLayer": "verification",
      "riskTokens": ["docs"]
    }
  ]
}
