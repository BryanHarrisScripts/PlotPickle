  "releaseTag": "v1.3.0",
  "releaseUrl": "https://github.com/earendil-works/pi/releases/tag/v1.3.0",
  "decision": "promote-after-green-candidate-proof",
  "requiredExtensions": [
    "npm:@dietrichgebert/ponytail@5.3.2",
    "npm:pi-subagents@0.79.0",
    "npm:@ff-labs/pi-fff@0.11.0",
    "npm:pi-context-view@0.7.1"
  ],
  "extensionAudit": [
    {
      "package": "@dietrichgebert/ponytail",
      "classification": "KEEP"
    },
    {
      "package": "pi-subagents",
      "classification": "KEEP"
    },
    {
      "package": "@ff-labs/pi-fff",
      "classification": "KEEP"
    },
    {
      "package": "pi-context-view",
      "classification": "KEEP"
    }
  ],
  "requiredCapabilities": {
    "supportedPackageRootSdk": true,
    "canonicalSessionContext": true,
    "contextEditEntry": true,
    "customEntry": true,
    "contextWithSystemExtensionEvent": true,
    "stdioRpc": true,
    "windowsPrivateManagedInstall": true,
    "noExtensionsBuiltInsAudit": true,
    "sessionToolBoundaries": true
