    "dottedStructuralBordersAllowed": false,
    "dashedStructuralBordersAllowed": false,
    "semanticExceptions": [
      {
        "id": "disabled-or-unavailable",
        "style": "dashed",
        "structural": false,
        "meaningRequired": true
      }
    ]
  },
