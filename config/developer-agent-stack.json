{
  "schemaVersion": 1,
  "platform": "windows-native",
  "sharedRules": "AGENTS.md",
  "skills": {
    "registry": "config/agent-skills.json",
    "root": ".agents/skills",
    "discovery": "progressive",
    "transport": "filesystem-first-mcp-resource-ready",
    "repairSkill": "uat-repair"
  },
  "requiredAgents": [
    {
      "id": "pi",
      "label": "Pi",
      "role": "primary-or-reviewer",
      "installCommand": "npm install -g --ignore-scripts @earendil-works/pi-coding-agent@0.84.4",
      "projectSettings": ".pi/settings.json"
    },
    {
      "id": "cline",
      "label": "Cline",
      "role": "primary-or-reviewer",
      "installCommand": "npm install -g cline",
      "projectSettings": ".cline"
    }
  ],
  "excludedRequiredTools": ["OpenHands", "Herdr"],
  "piPackages": [
    "npm:@dietrichgebert/ponytail@4.8.4",
    "npm:pi-subagents@0.35.1",
    "npm:@ff-labs/pi-fff@0.10.1",
    "npm:pi-mcp-adapter@2.26.0",
    "npm:pi-context-view@0.4.2"
  ],
  "piRuntime": {
    "requiredForFullVerification": true,
    "managedVersion": "0.84.4",
    "managedExecutablePolicy": "full-verification-managed-only",
    "autoProvisionMissingCli": true,
    "ensureCommand": "scripts/ensure-pi-repair-stack.mjs",
    "verifyCommand": "scripts/verify-pi-repair-worker.mjs",
    "localOnly": true,
    "cloudFallback": false,
    "providerConfigScope": "LOCALAPPDATA/PlotPickle/developer-agent"
  },
  "mcp": {
    "sharedConfig": ".mcp.json",
    "clineConfig": ".cline/mcp.json",
    "server": "plotpickle-dev",
    "command": "node",
    "args": ["scripts/developer-agent-mcp.mjs"]
  },
  "repair": {
    "command": "scripts/run-uat-repair-agent.mjs",
    "defaultWorker": "pi",
    "selectableWorkers": ["pi", "cline"],
    "legacyWorker": "mastra-qwen",
    "skill": "uat-repair",
    "localOnly": true,
    "cloudFallback": false,
    "requiresApprovedLocalCodingModel": true,
    "isolatedWorktree": true,
    "draftPrOnly": true
  },
  "codeQualityReview": {
    "deterministicObserver": "ben",
    "deterministicCommand": "scripts/run-ben-code-quality.mjs",
    "advisoryReviewer": "pi",
    "advisoryCommand": "scripts/run-pi-code-quality-review.mjs",
    "piTools": ["read", "grep", "find", "ls"],
    "writesAllowed": false,
    "authoritative": false,
    "artifactRoot": "LOCALAPPDATA/PlotPickle/full-verification/pi-code-quality"
  },
  "agentBench": {
    "runner": "scripts/run-agent-bench.mjs",
    "tasks": "config/agent-bench/tasks.json",
    "agents": ["pi", "cline"],
    "artifactRoot": ".artifacts/agent-bench"
  },
  "gates": [
    "node scripts/run-uat-autopilot.mjs --contracts-only --artifact-root .artifacts/uat-focused",
    "npm run build"
  ],
  "harness": {
    "schemaVersion": 1,
    "coordinator": "scripts/developer-agent-mcp.mjs",
    "policy": "AGENTS.md",
    "mode": "deterministic-hooks",
    "hooks": [
      {
        "id": "focused-uat",
        "responsibility": "Run the focused deterministic Startup, Settings, Foundations/LEARN, PLAN and Wyrmwood contracts.",
        "entrypoint": "node scripts/run-uat-autopilot.mjs --contracts-only --artifact-root .artifacts/uat-focused",
        "kind": "validation",
        "findingSource": true,
        "requiresLiveServer": false,
        "repairAuthority": false,
        "mergeAuthority": false
      },
      {
        "id": "webmcp-ui",
        "responsibility": "Inspect loaded rendered Skin V1 surfaces and emit privacy-safe deterministic UI-conformance findings.",
        "entrypoint": "node scripts/run-webmcp-startup-uat.mjs",
        "kind": "rendered-validation",
        "findingSource": true,
        "requiresLiveServer": true,
        "repairAuthority": false,
        "mergeAuthority": false
      },
      {
        "id": "closed-loop-uat",
        "responsibility": "Coordinate existing focused, conversational and exhaustive UAT findings and optional bounded report/repair handoff.",
        "entrypoint": "node scripts/run-uat-closed-loop.mjs",
        "kind": "finding-coordinator",
        "findingSource": true,
        "requiresLiveServer": true,
        "repairAuthority": false,
        "mergeAuthority": false
      },
      {
        "id": "uat-report",
        "responsibility": "Send deterministic UAT findings through the existing GitHub issue reporter when explicitly requested.",
        "entrypoint": "node scripts/report-uat-findings.mjs",
        "kind": "reporting",
        "findingSource": false,
        "requiresLiveServer": false,
        "repairAuthority": false,
        "mergeAuthority": false
      },
      {
        "id": "ben-code-quality",
        "responsibility": "Run BEN deterministic code-quality observation without source writes.",
        "entrypoint": "node scripts/run-ben-code-quality.mjs",
        "kind": "quality-validation",
        "findingSource": true,
        "requiresLiveServer": false,
        "repairAuthority": false,
        "mergeAuthority": false
      },
      {
        "id": "pi-code-quality-review",
        "responsibility": "Run the read-only advisory Pi code-quality review; deterministic checks remain authoritative.",
        "entrypoint": "node scripts/run-pi-code-quality-review.mjs",
        "kind": "advisory-review",
        "findingSource": false,
        "requiresLiveServer": false,
        "repairAuthority": false,
        "mergeAuthority": false
      },
      {
        "id": "build",
        "responsibility": "Build the production application as a deterministic verification gate.",
        "entrypoint": "npm run build",
        "kind": "build-validation",
        "findingSource": false,
        "requiresLiveServer": false,
        "repairAuthority": false,
        "mergeAuthority": false
      },
      {
        "id": "semantic-repair",
        "responsibility": "Prepare a bounded repair for one verified UAT fingerprint using the configured local Pi/Cline worker path.",
        "entrypoint": "node scripts/run-semantic-uat-repair.mjs",
        "kind": "bounded-repair",
        "findingSource": false,
        "requiresLiveServer": false,
        "repairAuthority": true,
        "mergeAuthority": false
      },
      {
        "id": "github-ci",
        "responsibility": "Independently validate the exact pull-request head and remain the only final merge gate.",
        "entrypoint": null,
        "kind": "external-merge-gate",
        "findingSource": false,
        "requiresLiveServer": false,
        "repairAuthority": false,
        "mergeAuthority": true
      }
    ],
    "flows": {
      "prePr": ["focused-uat", "build"],
      "liveUi": ["webmcp-ui"],
      "closedLoop": "verified finding -> existing UAT report -> bounded semantic repair -> rerun originating hook",
      "finalGate": "github-ci"
    }
  },
  "mergePolicy": "green-exact-head-only"
}
