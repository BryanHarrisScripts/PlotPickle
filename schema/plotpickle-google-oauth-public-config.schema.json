{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plotpickle.org/schemas/google-oauth-public-config/1.0/schema.json",
  "title": "PlotPickle public Google Desktop OAuth configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "product",
    "registrationStatus",
    "applicationType",
    "clientId",
    "authorizationUrl",
    "tokenUrl",
    "revokeUrl",
    "userInfoUrl",
    "tokenInfoUrl",
    "loopbackRedirect",
    "pkceMethod",
    "clientSecretPackaged",
    "identityScopes",
    "optionalScopes"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "product": { "const": "PlotPickle" },
    "registrationStatus": { "enum": ["pending-owner-registration", "registered"] },
    "applicationType": { "const": "desktop" },
    "clientId": { "type": "string", "maxLength": 300 },
    "authorizationUrl": { "const": "https://accounts.google.com/o/oauth2/v2/auth" },
    "tokenUrl": { "const": "https://oauth2.googleapis.com/token" },
    "revokeUrl": { "const": "https://oauth2.googleapis.com/revoke" },
    "userInfoUrl": { "const": "https://www.googleapis.com/oauth2/v3/userinfo" },
    "tokenInfoUrl": { "const": "https://oauth2.googleapis.com/tokeninfo" },
    "loopbackRedirect": { "const": true },
    "pkceMethod": { "const": "S256" },
    "clientSecretPackaged": { "const": false },
    "identityScopes": {
      "type": "array",
      "prefixItems": [
        { "const": "openid" },
        { "const": "email" },
        { "const": "profile" }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "optionalScopes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calendar", "meet"],
      "properties": {
        "calendar": { "const": "https://www.googleapis.com/auth/calendar.events.owned" },
        "meet": { "const": "https://www.googleapis.com/auth/meetings.space.created" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "registrationStatus": { "const": "registered" } },
        "required": ["registrationStatus"]
      },
      "then": {
        "properties": {
          "clientId": {
            "pattern": "^[0-9]+-[a-z0-9]+\\.apps\\.googleusercontent\\.com$"
          }
        }
      }
    }
  ]
}
