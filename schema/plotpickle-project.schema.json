{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plotpickle.app/schema/plotpickle-project.schema.json",
  "title": "PlotPickle Project",
  "description": "Canonical local-first story project shared by the Instructions, Story Planner, and Visual Board interfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "metadata", "story", "world", "development", "characters", "blocks"],
  "properties": {
    "schemaVersion": { "const": "1.3.0" },
    "id": { "type": "string", "minLength": 1 },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "subtitle", "format", "targetMinutes", "genre", "tone", "status", "createdAt", "updatedAt"],
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "format": { "type": "string" },
        "targetMinutes": { "type": "number", "minimum": 1 },
        "genre": { "type": "string" },
        "tone": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["premise", "logline", "theme", "antiTheme", "dramaticQuestion", "hook", "catalyst", "stakes", "ending", "notes"],
      "properties": {
        "premise": { "type": "string" },
        "logline": { "type": "string" },
        "theme": { "type": "string" },
        "antiTheme": { "type": "string" },
        "dramaticQuestion": { "type": "string" },
        "hook": { "type": "string" },
        "catalyst": { "type": "string" },
        "stakes": { "type": "string" },
        "ending": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinaryWorld", "newWorld", "period", "history", "cultures", "rules", "technology", "visualLanguage", "locations"],
      "properties": {
        "ordinaryWorld": { "type": "string" },
        "newWorld": { "type": "string" },
        "period": { "type": "string" },
        "history": { "type": "string" },
        "cultures": { "type": "string" },
        "rules": { "type": "string" },
        "technology": { "type": "string" },
        "visualLanguage": { "type": "string" },
        "locations": {
          "type": "array",
          "items": { "$ref": "#/$defs/location" }
        }
      }
    },
    "development": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storySetup", "pitch", "ghost", "catalyst", "foundations", "pickle", "dialogue", "notes"],
      "properties": {
        "storySetup": { "$ref": "#/$defs/storySetup" },
        "pitch": { "$ref": "#/$defs/pitch" },
        "ghost": { "$ref": "#/$defs/ghost" },
        "catalyst": { "$ref": "#/$defs/catalyst" },
        "foundations": { "$ref": "#/$defs/foundations" },
        "pickle": { "$ref": "#/$defs/pickle" },
        "dialogue": { "$ref": "#/$defs/dialogue" },
        "notes": { "$ref": "#/$defs/projectNotes" }
      }
    },
    "characters": {
      "type": "array",
      "items": { "$ref": "#/$defs/character" }
    },
    "blocks": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": { "$ref": "#/$defs/block" }
    }
  },
  "$defs": {
    "storySetup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience", "contentRating", "language", "scope", "collaborators"],
      "properties": {
        "audience": { "type": "string" },
        "contentRating": { "type": "string" },
        "language": { "type": "string" },
        "scope": { "type": "string" },
        "collaborators": { "type": "string" }
      }
    },
    "pitch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oneSentence", "shortPitch", "audiencePromise", "emotionalExperience", "comparableTitles", "visualVision"],
      "properties": {
        "oneSentence": { "type": "string" },
        "shortPitch": { "type": "string" },
        "audiencePromise": { "type": "string" },
        "emotionalExperience": { "type": "string" },
        "comparableTitles": { "type": "string" },
        "visualVision": { "type": "string" }
      }
    },
    "ghost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["centralWound", "origin", "lie", "trigger", "presentPattern", "truth"],
      "properties": {
        "centralWound": { "type": "string" },
        "origin": { "type": "string" },
        "lie": { "type": "string" },
        "trigger": { "type": "string" },
        "presentPattern": { "type": "string" },
        "truth": { "type": "string" }
      }
    },
    "catalyst": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "timing", "immediateImpact", "choiceForced", "resistance", "doorway"],
      "properties": {
        "event": { "type": "string" },
        "timing": { "type": "string" },
        "immediateImpact": { "type": "string" },
        "choiceForced": { "type": "string" },
        "resistance": { "type": "string" },
        "doorway": { "type": "string" }
      }
    },
    "foundations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protagonist", "objective", "opposition", "urgency", "storyEngine", "transformation", "endingProof"],
      "properties": {
        "protagonist": { "type": "string" },
        "objective": { "type": "string" },
        "opposition": { "type": "string" },
        "urgency": { "type": "string" },
        "storyEngine": { "type": "string" },
        "transformation": { "type": "string" },
        "endingProof": { "type": "string" }
      }
    },
    "pickle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["centralTension", "audienceQuestion", "storyPromise", "expectedDestination", "unpredictableRoute", "liveAnswerA", "liveAnswerB", "escalationPattern", "finalAnswer", "signatureMove"],
      "properties": {
        "centralTension": { "type": "string" },
        "audienceQuestion": { "type": "string" },
        "storyPromise": { "type": "string" },
        "expectedDestination": { "type": "string" },
        "unpredictableRoute": { "type": "string" },
        "liveAnswerA": { "type": "string" },
        "liveAnswerB": { "type": "string" },
        "escalationPattern": { "type": "string" },
        "finalAnswer": { "type": "string" },
        "signatureMove": { "type": "string" }
      }
    },
    "dialogue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principles", "voiceContrast", "subtext", "expositionRules", "recurringLanguage", "notes"],
      "properties": {
        "principles": { "type": "string" },
        "voiceContrast": { "type": "string" },
        "subtext": { "type": "string" },
        "expositionRules": { "type": "string" },
        "recurringLanguage": { "type": "string" },
        "notes": { "type": "string" },
        "worldVernacular": { "type": "string", "description": "Shared slang, technical language, forms of address, and speech rules created by the story world." },
        "monologueRules": { "type": "string", "description": "Conditions that make a long speech earned, persuasive, and scene-changing." },
        "subtextSeeds": { "type": "string", "description": "Objects, repeated words, actions, and callbacks that can accumulate hidden meaning." },
        "fieldworkNotes": { "type": "string", "description": "Original observations about rhythm, hesitation, repetition, status shifts, and other reusable speech fingerprints." }
      }
    },
    "projectNotes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["general", "research", "openQuestions", "continuity", "revisions", "sources"],
      "properties": {
        "general": { "type": "string" },
        "research": { "type": "string" },
        "openQuestions": { "type": "string" },
        "continuity": { "type": "string" },
        "revisions": { "type": "string" },
        "sources": { "type": "string" }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "image"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string" }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["characterId", "label", "description"],
      "properties": {
        "characterId": { "type": "string" },
        "label": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "role", "pronouns", "description", "want", "need", "ghost", "fatalFlaw", "strengths", "arc", "voice", "image", "relationships"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "pronouns": { "type": "string" },
        "description": { "type": "string" },
        "want": { "type": "string" },
        "need": { "type": "string" },
        "ghost": { "type": "string", "description": "Past wound, loss, trauma, or belief still controlling the character." },
        "fatalFlaw": { "type": "string" },
        "strengths": { "type": "string" },
        "arc": { "type": "string" },
        "voice": { "type": "string", "description": "Compact scene-by-scene voice rule." },
        "originEnvironment": { "type": "string", "description": "Geography, community, family, work, culture, and formative surroundings." },
        "socialContext": { "type": "string", "description": "Class, status, money, institutions, belonging, and exclusion." },
        "educationExpertise": { "type": "string", "description": "Formal education, practical knowledge, professional language, and blind spots." },
        "worldviewBoundaries": { "type": "string", "description": "Beliefs, loyalties, taboos, assumptions, and subjects the character avoids." },
        "rhythmSentenceShape": { "type": "string", "description": "Speed, sentence length, directness, interruption, and structural habits." },
        "vocabularyMetaphors": { "type": "string", "description": "Preferred words, references, comparisons, and areas of fluency." },
        "verbalFingerprints": { "type": "string", "description": "Repeated connectors, fillers, corrections, jokes, deflections, and signature phrasing." },
        "emotionalAccess": { "type": "string", "description": "What can be stated directly, disguised, or not admitted." },
        "statusShift": { "type": "string", "description": "How speech changes with authority, intimacy, fear, attraction, rivalry, or dependence." },
        "persuasionStrategy": { "type": "string", "description": "How the character asks, pressures, charms, bargains, threatens, proves, or avoids." },
        "image": { "type": "string" },
        "relationships": {
          "type": "array",
          "items": { "$ref": "#/$defs/relationship" }
        }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "src", "alt", "caption", "prompt", "shot", "continuity"],
      "properties": {
        "id": { "type": "string" },
        "src": { "type": "string" },
        "alt": { "type": "string" },
        "caption": { "type": "string" },
        "prompt": { "type": "string" },
        "shot": { "type": "string" },
        "continuity": { "type": "string" }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "number", "act", "title", "purpose", "summary", "characterIds", "locationIds", "goal", "conflict", "choice", "action", "consequence", "emotionalTurn", "audienceExpectation", "pickleTurn", "setup", "payoff", "scriptExcerpt", "storyboardDirection", "notes", "visuals"],
      "properties": {
        "id": { "type": "string" },
        "number": { "type": "integer", "minimum": 1, "maximum": 24 },
        "act": { "type": "integer", "minimum": 1, "maximum": 4 },
        "title": { "type": "string" },
        "purpose": { "type": "string" },
        "summary": { "type": "string" },
        "characterIds": { "type": "array", "items": { "type": "string" } },
        "locationIds": { "type": "array", "items": { "type": "string" } },
        "goal": { "type": "string" },
        "conflict": { "type": "string" },
        "choice": { "type": "string" },
        "action": { "type": "string" },
        "consequence": { "type": "string" },
        "emotionalTurn": { "type": "string" },
        "audienceExpectation": { "type": "string", "description": "What the audience is likely to believe, expect, hope, or fear after this block." },
        "pickleTurn": { "type": "string", "description": "The clue, reversal, complication, near-answer, or reframe that refreshes the central audience tension." },
        "setup": { "type": "string" },
        "payoff": { "type": "string" },
        "scriptExcerpt": { "type": "string" },
        "storyboardDirection": { "type": "string" },
        "notes": { "type": "string" },
        "visuals": { "type": "array", "items": { "$ref": "#/$defs/visual" } }
      }
    }
  }
}
