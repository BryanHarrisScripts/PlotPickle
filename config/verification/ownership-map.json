{
  "$schema": "../../schema/verification/ownership.schema.json",
  "schemaVersion": "1.0",
  "sourceArchitecture": "architecture/plotpickle.architecture.json",
  "unknownProduction": {
    "policy": "fail-closed",
    "evidenceCode": "unmapped-production-ownership"
  },
  "rules": [
    {
      "id": "experience-skin-v1",
      "classification": "production",
      "include": ["app/skin-v1/**", "app/skin-v1-definition.css"],
      "ownerLayer": "experience-skins",
      "riskTokens": ["skin", "surface", "navigation", "visual", "mcp"]
    },
    {
      "id": "experience-surface-registry",
      "classification": "production",
      "include": ["lib/experience/surface-registry.ts"],
      "ownerLayer": "experience-contract",
      "riskTokens": ["surface", "navigation", "mcp"]
    },
    {
      "id": "webmcp-live-verifier",
      "classification": "verification",
      "include": [
        "lib/verification/webmcp-*.mjs",
        "lib/verification/skin-v1-menu-contract-audit.mjs",
        "scripts/run-webmcp-startup-uat.mjs",
        "scripts/verification-webmcp-live.mjs"
      ],
      "ownerLayer": "verification",
      "riskTokens": ["surface", "navigation", "visual", "mcp", "test-harness"]
    },
    {
      "id": "verification-contract-files",
      "classification": "verification",
      "include": [
        ".github/workflows/**",
        "config/development-convergence/**",
        "config/verification/**",
        "schema/verification/**",
        "lib/verification/**",
        "scripts/validate-verification-phase-1.mjs",
        "scripts/verification-core.mjs",
        "scripts/verification-shadow.mjs"
      ],
      "ownerLayer": "verification",
      "riskTokens": ["test-harness", "cli"]
    },
    {
      "id": "verification-tests",
      "classification": "test",
      "include": ["tests/**"],
      "ownerLayer": "verification",
      "riskTokens": ["test-harness"]
    },
    {
      "id": "verification-docs",
      "classification": "docs",
      "include": ["docs/**"],
      "ownerLayer": "verification",
      "riskTokens": ["docs"]
    }
  ]
}
