{
  "$schema": "../../schema/verification/ownership.schema.json",
  "schemaVersion": "1.0",
  "sourceArchitecture": "architecture/plotpickle.architecture.json",
  "unknownProduction": {
    "policy": "fail-closed",
    "evidenceCode": "unmapped-production-ownership"
  },
  "rules": [
    {
      "id": "experience-skin-v1",
      "classification": "production",
      "include": ["app/skin-v1/**", "app/skin-v1-*.css", "app/skin-v1-definition.css"],
      "ownerLayer": "experience-skins",
      "riskTokens": ["skin", "surface", "navigation", "visual", "mcp"]
    },
    {
      "id": "windows-local-launcher",
      "classification": "production",
      "include": ["PlotPickle.ps1", "Start-PlotPickle.bat"],
      "ownerLayer": "experience-skins",
      "riskTokens": ["windows", "native", "mcp", "surface"]
    },
    {
      "id": "experience-surface-registry",
      "classification": "production",
      "include": ["lib/experience/surface-registry.ts"],
      "ownerLayer": "experience-contract",
      "riskTokens": ["surface", "navigation", "mcp"]
    },
    {
      "id": "learn-journey-preview-api",
      "classification": "production",
      "include": ["app/api/learn/journey-preview/route.ts"],
      "ownerLayer": "experience-contract",
      "riskTokens": ["surface", "navigation", "canon"]
    },
    {
      "id": "learn-program-map",
      "classification": "production",
      "include": ["learn/program-map.mjs", "learn/program-map-spec.mjs"],
      "ownerLayer": "story-canon",
      "riskTokens": ["canon", "graph"]
    },
    {
      "id": "learn-program-map-validator",
      "classification": "verification",
      "include": ["scripts/validate-learn-program-map.mjs"],
      "ownerLayer": "verification",
      "riskTokens": ["canon", "test-harness", "cli"]
    },
    {
      "id": "learn-curriculum-integrity-harness",
      "classification": "verification",
      "include": [
        "scripts/learn-curriculum-integrity.mjs",
        "scripts/validate-learn-curriculum-integrity.mjs"
      ],
      "ownerLayer": "verification",
      "riskTokens": ["canon", "graph", "test-harness", "cli"]
    },
    {
      "id": "webmcp-live-verifier",
      "classification": "verification",
      "include": [
        "lib/verification/webmcp-*.mjs",
        "lib/verification/skin-v1-menu-contract-audit.mjs",
        "scripts/run-webmcp-startup-uat.mjs",
        "scripts/verification-webmcp-live.mjs"
      ],
      "ownerLayer": "verification",
      "riskTokens": ["surface", "navigation", "visual", "mcp", "test-harness"]
    },
    {
      "id": "verification-contract-files",
      "classification": "verification",
      "include": [
        ".github/workflows/**",
        "config/development-convergence/**",
        "config/verification/**",
        "schema/verification/**",
        "lib/verification/**",
        "scripts/validate-verification-phase-1.mjs",
        "scripts/verification-core.mjs",
        "scripts/verification-shadow.mjs"
      ],
      "ownerLayer": "verification",
      "riskTokens": ["test-harness", "cli"]
    },
    {
      "id": "architecture-blueprint",
      "classification": "docs",
      "include": ["architecture/**"],
      "ownerLayer": "verification",
      "riskTokens": ["docs", "test-harness"]
    },
    {
      "id": "repository-readme",
      "classification": "docs",
      "include": ["README.md"],
      "ownerLayer": "verification",
      "riskTokens": ["docs"]
    },
    {
      "id": "verification-tests",
      "classification": "test",
      "include": ["tests/**"],
      "ownerLayer": "verification",
      "riskTokens": ["test-harness"]
    },
    {
      "id": "verification-docs",
      "classification": "docs",
      "include": ["docs/**"],
      "ownerLayer": "verification",
      "riskTokens": ["docs"]
    }
  ]
}
